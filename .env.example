# Copy to .env.local for local use, or set these in your host's settings.

# Required for /admin. Admin stays locked until this is at least 16 characters.
ADMIN_PASSWORD=

# Optional. Without it, contact messages are only saved to the admin inbox.
# Create a key at https://resend.com to also get them by email.
RESEND_API_KEY=
# Sender address. Needs a domain verified in Resend once you have your own.
MAIL_FROM=

# Required on hosts with no lasting disk, such as Vercel. Any Postgres works.
# Leave empty to use a local SQLite file at data/site.db.
DATABASE_URL=
